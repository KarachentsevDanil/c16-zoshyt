{
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(./dumps/**)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "ask": [
      "Bash(docker compose * npm run send-*)"
    ],
    "allow": [
      "Bash(npm test *)",
      "Bash(docker compose exec -T web npm test *)",
      "Bash(docker compose exec -T web npx prisma migrate dev *)",
      "WebFetch(domain:nodejs.org)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": ["docker *"],
    "network": {
      "allowedDomains": ["registry.npmjs.org"]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/no-real-students.sh",
            "args": []
          }
        ]
      }
    ]
  }
}
