{
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "allow": [
      "Bash(npm test *)",
      "Bash(docker compose exec *)",
      "WebFetch"
    ]
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": ["docker *"],
    "network": {
      "allowedDomains": ["registry.npmjs.org"]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/no-real-students.sh",
            "args": []
          }
        ]
      }
    ]
  }
}
